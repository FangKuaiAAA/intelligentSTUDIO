<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoEditor.Views.ErasePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="20,4,18,24" Spacing="20">

            <StackPanel Spacing="4">
                <Grid>
                    <TextBlock Text="笔刷" FontSize="12" Foreground="{StaticResource AppTextSecondary}" />
                    <TextBlock x:Name="BrushLabel" Text="36" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{StaticResource AppTextTertiary}" />
                </Grid>
                <Slider x:Name="BrushSlider" Minimum="12" Maximum="96" Value="36"
                        ValueChanged="OnBrushChanged" />
            </StackPanel>

            <Button Content="清除涂抹" Style="{StaticResource GlassPillButtonStyle}"
                    HorizontalAlignment="Stretch" Click="OnClearClicked" />

            <StackPanel x:Name="EngineSection" Spacing="8">
                <TextBlock Text="补全方式" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <RadioButton GroupName="EngineGroupErase" x:Name="EngineBuiltin" Content="内置" Tag="builtin"
                                  Style="{StaticResource SegmentItemStyle}"
                                  Click="OnEngineClicked" IsChecked="True" />
                    <RadioButton GroupName="EngineGroupErase" x:Name="EngineApi" Content="接口" Tag="api"
                                  Style="{StaticResource SegmentItemStyle}"
                                  Click="OnEngineClicked" />
                </StackPanel>
                <TextBlock x:Name="EngineHint" Style="{StaticResource TertiaryTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button x:Name="EraseButton" Content="消除所选" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Stretch" Click="OnEraseClicked" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
