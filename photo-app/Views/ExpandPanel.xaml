<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoEditor.Views.ExpandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="20,4,18,24" Spacing="20">

            <StackPanel Spacing="4">
                <Grid>
                    <TextBlock Text="扩展大小" FontSize="12" Foreground="{StaticResource AppTextSecondary}" />
                    <TextBlock x:Name="ExpandLabel" Text="25%" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{StaticResource AppTextTertiary}" />
                </Grid>
                <Slider x:Name="ExpandSlider" Minimum="4" Maximum="150" Value="25" StepFrequency="2"
                        ValueChanged="OnExpandChanged" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="扩展后的比例" FontSize="12" Foreground="{StaticResource AppTextSecondary}" />
                <ComboBox x:Name="RatioBox" HorizontalAlignment="Stretch"
                          SelectionChanged="OnRatioChanged" />
                <TextBlock x:Name="SizeLabel" Style="{StaticResource TertiaryTextStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="左" FontSize="11" Foreground="{StaticResource AppTextTertiary}" />
                    <TextBlock x:Name="LeftLabel" Text="25%" FontSize="13"
                               Foreground="{StaticResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="右" FontSize="11" Foreground="{StaticResource AppTextTertiary}" />
                    <TextBlock x:Name="RightLabel" Text="25%" FontSize="13"
                               Foreground="{StaticResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="上" FontSize="11" Foreground="{StaticResource AppTextTertiary}" />
                    <TextBlock x:Name="TopLabel" Text="25%" FontSize="13"
                               Foreground="{StaticResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="2">
                    <TextBlock Text="下" FontSize="11" Foreground="{StaticResource AppTextTertiary}" />
                    <TextBlock x:Name="BottomLabel" Text="25%" FontSize="13"
                               Foreground="{StaticResource AppTextPrimary}" />
                </StackPanel>
            </Grid>

            <Button Content="重置位置与大小" Style="{StaticResource GlassPillButtonStyle}"
                    HorizontalAlignment="Stretch" Click="OnResetInsets" />

            <StackPanel x:Name="EngineSection" Spacing="8">
                <TextBlock Text="补全方式" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <RadioButton GroupName="EngineGroupExpand" x:Name="EngineBuiltin" Content="内置" Tag="builtin"
                                  Style="{StaticResource SegmentItemStyle}" Click="OnEngineClicked" />
                    <RadioButton GroupName="EngineGroupExpand" x:Name="EngineApi" Content="接口" Tag="api"
                                  Style="{StaticResource SegmentItemStyle}" Click="OnEngineClicked" IsChecked="True" />
                </StackPanel>
                <TextBlock x:Name="EngineHint" Style="{StaticResource TertiaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="ExpandButton" Content="确认扩展" Style="{StaticResource PillButtonStyle}"
                    HorizontalAlignment="Stretch" Click="OnExpandClicked" />
            <TextBlock x:Name="CurrentHint" Style="{StaticResource TertiaryTextStyle}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
