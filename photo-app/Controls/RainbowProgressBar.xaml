<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoEditor.Controls.RainbowProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="Root" Spacing="8" Opacity="0">
        <Border Width="248" Height="4" CornerRadius="2" Background="#26FFFFFF"
                HorizontalAlignment="Center">
            <Border x:Name="Fill" HorizontalAlignment="Stretch" CornerRadius="2"
                    Background="{StaticResource AppAccentBlue}"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FillScale" ScaleX="0" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
        </Border>
        <TextBlock x:Name="Label" FontSize="11.5" HorizontalAlignment="Center"
                   Foreground="{StaticResource AppTextSecondary}" Text="正在处理" />
    </StackPanel>
</UserControl>
