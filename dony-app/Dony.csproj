<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Dony</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 非打包（免 MSIX）+ 自包含（免安装 Windows App SDK 运行时） -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Dony</AssemblyName>
    <Company>方块AAA</Company>
    <Product>intelligentSTUDIO</Product>
    <Copyright>Copyright © 2026 方块AAA</Copyright>
    <!-- exe 自身的图标（任务栏/资源管理器/Alt+Tab 都用它）。
         图标来自稳定目录 assets/icons，详见 assets/icons/README.md -->
    <ApplicationIcon>..\assets\icons\Dony.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同一张图标再复制一份到输出目录：运行时用 AppWindow.SetIcon 设窗口图标
         （ApplicationIcon 只管 exe 自己的图标，不管窗口） -->
    <Content Include="..\assets\icons\Dony.ico" Link="Dony.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
