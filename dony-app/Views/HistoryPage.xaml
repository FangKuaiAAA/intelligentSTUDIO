<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dony.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dony.Controls"
    xmlns:local="using:Dony"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20,12,20,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="308" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 历史会话列表 -->
        <Border Grid.Column="0" Style="{StaticResource DonyCardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="6,4,6,8">
                    <TextBlock Text="对话记录" Style="{StaticResource DonyTitleStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" HorizontalAlignment="Right" Click="Refresh_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>

                <ListView x:Name="SessionList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="Session_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SessionSummary">
                            <Grid Padding="4,7" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="DeleteSession_Click" Padding="6,2"
                                        ToolTipService.ToolTip="删除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint" Grid.Row="1" Margin="10" TextWrapping="Wrap"
                           Opacity="0.6" FontSize="12" Visibility="Collapsed"
                           Text="还没有对话。按 Alt+Space 唤醒 Dony 开始。" />
            </Grid>
        </Border>

        <!-- 会话内容 + 继续对话 -->
        <Border Grid.Column="1" Style="{StaticResource DonyCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,14,14,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="DetailTitle" Text="选择一条对话" Style="{StaticResource DonyTitleStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailMeta" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RenameButton" Click="Rename_Click" IsEnabled="False"
                            ToolTipService.ToolTip="重命名">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- 空态水印：两个同心圆环（内环粗、外环细而更淡），取自应用图标。
                         只做视觉压印：不接管鼠标，也不参与布局。 -->
                    <Grid x:Name="EmptyWatermark" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 两圈相切：内环直径 216 / 描边 14 ⇒ 外沿半径 115；
                             外环直径 236 / 描边 3 ⇒ 内沿正好压在 115 上，看起来连成一圈。
                             内浓外淡：0.065 vs 0.028。 -->
                        <Ellipse Width="240" Height="240"
                                 Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                 StrokeThickness="4" Opacity="0.045" />
                        <Ellipse Width="216" Height="216"
                                 Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                 StrokeThickness="14" Opacity="0.070" />
                    </Grid>

                    <ScrollViewer x:Name="MsgScroll" Padding="4,0,4,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MsgPanel" Padding="18,4,18,14" Spacing="12">
                            <TextBlock x:Name="DetailHint" Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                                       Text="从左侧选择一条对话，或按 Alt+Space 开始新的对话。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:GlowChatBox x:Name="ChatBox" Grid.Row="2" Margin="12,6,12,12"
                                      IsEnabled="False" Submitted="ChatBox_Submitted" />
            </Grid>
        </Border>
    </Grid>
</Page>
