{
  "manifest_version": 3,
  "name": "Visual intelligence",
  "version": "1.3.3",
  "description": "Visual intelligence —— 浏览器扩展：在浮窗内直接使用视觉智能，并让 Dony 读取与整理标签页与收藏夹（需 intelligentSTUDIO 桌面端运行）。",
  "minimum_chrome_version": "110",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8768/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Visual intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["Visual.mp3", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
