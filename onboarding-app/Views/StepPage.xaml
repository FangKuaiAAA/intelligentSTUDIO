<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IntelligentStudio.Onboarding.Views.StepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IntelligentStudio.Onboarding.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:OnboardingMedia x:Name="Media" Grid.Row="0" />

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="32,0,32,8"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- 首页顶部居中的大图标 -->
                <StackPanel x:Name="HeroBlock" HorizontalAlignment="Center" Margin="0,0,0,20"
                            Visibility="Collapsed">
                    <Image x:Name="HeroIcon" Width="112" Height="112" Stretch="Uniform" />
                </StackPanel>

                <StackPanel x:Name="ContentColumn" Spacing="20" MaxWidth="760"
                            HorizontalAlignment="Left">
                    <!-- 图标 + 标题 + 介绍 -->
                    <Grid x:Name="HeaderBlock" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="StepIcon" Width="44" Height="44" VerticalAlignment="Top"
                               Stretch="Uniform" />
                        <StackPanel x:Name="HeaderText" Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="TitleText" Style="{StaticResource OnboardingTitleStyle}" />
                            <TextBlock x:Name="DescText" Style="{StaticResource OnboardingSecondaryStyle}"
                                       FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- 朗读回复 -->
                    <StackPanel x:Name="VoiceOptions" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="朗读回复" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel>
                            <RadioButton x:Name="VoiceOff" GroupName="VoiceRead" Content="关闭"
                                         Checked="VoiceMode_Checked" />
                            <RadioButton x:Name="VoiceAlways" GroupName="VoiceRead"
                                         Content="始终朗读回复" Checked="VoiceMode_Checked" />
                            <RadioButton x:Name="VoiceOnly" GroupName="VoiceRead"
                                         Content="仅在语音使用 Dony 时朗读回复"
                                         Checked="VoiceMode_Checked" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 单个开关：双击 Ctrl -->
                    <Border x:Name="WritingOption" Style="{StaticResource OnboardingCardStyle}"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="双击 Ctrl 启动书写辅助" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource OnboardingSecondaryStyle}"
                                           Text="开启后，选中文字并双击 Ctrl 直接打开改写面板；未选中文字时不显示。" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WritingToggle" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="双击 Ctrl 启动书写辅助"
                                          Toggled="Writing_Toggled" />
                        </Grid>
                    </Border>

                    <!-- 两个开关：通知智能与智能勿扰 -->
                    <Border x:Name="NotifyOptions" Style="{StaticResource OnboardingCardStyle}"
                            Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="通知智能" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource OnboardingSecondaryStyle}"
                                               Text="开启后，同一应用的通知合并为一条摘要，并写入通知中心；不受专注模式影响。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SummaryToggle" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="通知智能"
                                              Toggled="Notify_Toggled" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="智能勿扰模式" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource OnboardingSecondaryStyle}"
                                               Text="开启后，重要通知以右下角卡片提醒，其余通知不弹出提醒，仅计入摘要。需与系统专注模式同时开启。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DndToggle" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="智能勿扰模式"
                                              Toggled="Notify_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 扩展安装 -->
                    <StackPanel x:Name="InstallBlock" Spacing="10" Visibility="Collapsed">
                        <Button x:Name="InstallButton" MinWidth="152" Height="36" CornerRadius="8"
                                HorizontalAlignment="Left" Click="Install_Click" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="InstallProgress" Width="16" Height="16"
                                          IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="InstallHint" Style="{StaticResource OnboardingSecondaryStyle}"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <InfoBar x:Name="InstallBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                    <InfoBar x:Name="OptionsBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
