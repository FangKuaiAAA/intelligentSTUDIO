<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImagePlayground.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <UniformGridLayout x:Key="HistoryLayout"
                           MinItemWidth="248" MinItemHeight="248"
                           MinRowSpacing="16" MinColumnSpacing="16"
                           ItemsStretch="Fill" ItemsJustification="Start" />
    </UserControl.Resources>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="历史" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CountText" Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="正在读取…" />
            </StackPanel>
            <Button x:Name="RefreshButton" Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                    Style="{StaticResource GlyphIconButtonStyle}"
                    Click="Refresh_Click" ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" Padding="0,0,0,24">
                <ItemsRepeater x:Name="Tiles" Layout="{StaticResource HistoryLayout}" Margin="0,2,0,0">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="248" CornerRadius="16" Background="#14FFFFFF"
                                  BorderThickness="1" BorderBrush="#18FFFFFF"
                                  Tapped="Tile_Tapped"
                                  PointerEntered="Tile_PointerEntered"
                                  PointerExited="Tile_PointerExited">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                                <!-- 删除：常驻在磁贴右上角，点按不触发打开大图 -->
                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                        Background="#99000000" BorderThickness="0"
                                        Style="{StaticResource PillButtonStyle}"
                                        Click="TileDelete_Click" ToolTipService.ToolTip="删除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#E6FFFFFF" />
                                </Button>

                                <Border VerticalAlignment="Bottom" Height="72"
                                        CornerRadius="0,0,16,16" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#B8000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,10" Spacing="3">
                                        <TextBlock Text="{Binding StyleName}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding CreatedText}" FontSize="10.5"
                                                   Foreground="#B3FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14" Visibility="Collapsed">
                <FontIcon Glyph="&#xEB9F;" FontSize="34" Foreground="{StaticResource AppTextTertiary}" />
                <TextBlock Text="还没有作品" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="生成后点击「保存」，作品会出现在这里。"
                           Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                <Button Content="新建作品" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Style="{StaticResource GlassPillButtonStyle}" Click="GoCreate_Click" />
            </StackPanel>
        </Grid>

        <!-- 放大查看 -->
        <Grid x:Name="ViewerLayer" Grid.RowSpan="2" Background="#B8000000"
              Visibility="Collapsed" Opacity="0" Tapped="ViewerLayer_Tapped">
            <Grid Margin="56,64,40,64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="ViewerScroller" Grid.Column="0"
                              ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                              RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              MaxWidth="940" MaxHeight="660">
                    <ScrollViewer.RenderTransform>
                        <ScaleTransform x:Name="ViewerScale" ScaleX="1" ScaleY="1" />
                    </ScrollViewer.RenderTransform>
                    <Image x:Name="ViewerImage" Stretch="Uniform" Opacity="0" />
                </ScrollViewer>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="22,0,0,0">
                    <Button x:Name="ViewerShareButton" Content="共享" MinWidth="100"
                            Style="{StaticResource GlassPillButtonStyle}" Click="ViewerShare_Click" />
                    <Button x:Name="ViewerSaveButton" Content="保存" MinWidth="100"
                            Style="{StaticResource PillButtonStyle}" Height="40" FontSize="13"
                            Click="ViewerSave_Click" />
                    <Button x:Name="ViewerDeleteButton" Content="删除" MinWidth="100"
                            Style="{StaticResource GlassPillButtonStyle}" Height="40" FontSize="13"
                            Foreground="#FFFF453A" Click="ViewerDelete_Click" />
                </StackPanel>
            </Grid>

            <Button x:Name="ViewerCloseButton" Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,22,0"
                    Style="{StaticResource GlyphIconButtonStyle}" Click="ViewerClose_Click"
                    ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE711;" FontSize="11" />
            </Button>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                    Background="#66000000" CornerRadius="10" Padding="14,7">
                <TextBlock x:Name="ViewerCaption" FontSize="12" Foreground="#D9FFFFFF" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
