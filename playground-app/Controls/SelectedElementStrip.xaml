<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImagePlayground.Controls.SelectedElementStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Height="60">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      ZoomMode="Disabled">
            <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Center"
                        Padding="2,6,14,6" />
        </ScrollViewer>

        <TextBlock x:Name="Placeholder" IsHitTestVisible="False"
                   Text="选择元素，或输入描述"
                   FontSize="12.5" Foreground="{StaticResource AppTextTertiary}"
                   VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>
</UserControl>
