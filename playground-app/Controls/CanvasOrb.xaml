<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImagePlayground.Controls.CanvasOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Width="560" Height="560">
        <Grid x:Name="Stage" Width="560" Height="560">

            <!-- 投影：在深色底上只做很轻的一层，避免发灰 -->
            <Ellipse x:Name="ShadowPool" Width="520" Height="520"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4A000000" Offset="0.0" />
                        <GradientStop Color="#24000000" Offset="0.62" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 彩虹光边宿主：位于白圆之下，只有溢出的部分可见 -->
            <Canvas x:Name="EdgeHost" IsHitTestVisible="False" />

            <!-- 白色磨砂大圆 -->
            <Border x:Name="CircleShadow" Width="420" Height="420" CornerRadius="210"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="#22FFFFFF">
                <Border.Background>
                    <!-- 近白渐变：在深色 Mica 上呈现干净的磨砂白面（Acrylic 在深色底会被压成灰） -->
                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#FFF8F8FB" Offset="0.55" />
                        <GradientStop Color="#FFEDEDF3" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 生成结果：560 容器，用几何裁剪从 D 圆平滑扩为圆角方形 -->
            <Grid x:Name="ResultHost" Width="560" Height="560"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed" Opacity="0">
                <Border x:Name="Surface" Width="560" Height="560" CornerRadius="40"
                        Background="#FFFFFFFF" BorderThickness="1" BorderBrush="#14FFFFFF" />
                <Image x:Name="ResultImage" Width="560" Height="560" Stretch="UniformToFill" />
            </Grid>

            <!-- 圆心内容层：空态提示 / 进度 / 错误 -->
            <Grid x:Name="CircleLayer" Width="420" Height="420"
                  HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE91B;" FontSize="26" Foreground="#3D000000" />
                    <TextBlock Text="选择元素，或描述画面" FontSize="13"
                               Foreground="#70000000" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,46" Spacing="12" Opacity="0" Visibility="Collapsed">
                    <Border Width="230" Height="4" CornerRadius="2" Background="#1F000000">
                        <Border x:Name="ProgressFill" Width="230" Height="4" CornerRadius="2"
                                HorizontalAlignment="Left" Background="{StaticResource AppAccentBlue}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock x:Name="ProgressText" Text="正在生成" FontSize="11.5"
                               Foreground="#8C000000" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="320" Opacity="0" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#CCFF453A"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" Foreground="#A6000000" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <!-- 白圆上的按钮需要深色前景，否则白字看不见 -->
                        <Button x:Name="RetryButton" Content="重试" Height="32" Padding="16,0"
                                CornerRadius="16" FontSize="12"
                                Foreground="#CC1B1B20" Background="#12000000"
                                BorderBrush="#1F000000" BorderThickness="1"
                                Style="{StaticResource PillButtonStyle}" />
                        <Button x:Name="OpenSettingsButton" Content="打开 STUDIO 设置" Height="32" Padding="16,0"
                                CornerRadius="16" FontSize="12" Visibility="Collapsed"
                                Foreground="#CC1B1B20" Background="#12000000"
                                BorderBrush="#1F000000" BorderThickness="1"
                                Style="{StaticResource PillButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 完成态右侧操作按钮：负外边距把按钮浮在画布右侧，不改变画布位置 -->
        <StackPanel x:Name="ActionPanel" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,-118,0" Spacing="10" Opacity="0" IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ActionShift" X="12" />
            </StackPanel.RenderTransform>
            <Button x:Name="ShareButton" Content="共享" MinWidth="100"
                    Style="{StaticResource GlassPillButtonStyle}" />
            <Button x:Name="SaveButton" Content="保存" MinWidth="100"
                    Style="{StaticResource PillButtonStyle}" Height="40" FontSize="13" />
        </StackPanel>
    </Grid>
</UserControl>
