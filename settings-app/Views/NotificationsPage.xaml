<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DonySettings.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="StatusOkBrush" Color="#107C10" />
        <SolidColorBrush x:Key="StatusBadBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="StatusIdleBrush" Color="#8A8A8A" />
    </Page.Resources>

    <ScrollViewer Padding="20,12,20,20">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="通知智能和勿扰" Style="{StaticResource DonyTitleStyle}" />

            <!-- 介绍 -->
            <Border Style="{StaticResource DonyCardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <Image Source="ms-appx:///intelligentSTUDIO.png" Width="64" Height="64"
                           HorizontalAlignment="Left" />
                    <TextBlock Text="通知智能和勿扰" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DonySecondaryStyle}" FontSize="13"
                               Text="为 app 的通知生成摘要。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DonyCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="通知处理" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="通知智能" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DonySecondaryStyle}"
                                       Text="开启后，同一应用的通知合并为一条摘要，并写入通知中心；不受专注模式影响。" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SummaryToggle" Grid.Column="1"
                                      Toggled="Summary_Toggled" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="智能勿扰模式" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DonySecondaryStyle}"
                                       Text="开启后，重要通知以右下角卡片提醒，其余通知不弹出提醒，仅计入摘要。需与系统专注模式同时开启；不更改系统设置。" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DndToggle" Grid.Column="1"
                                      Toggled="Dnd_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DonyCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="运行状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="RefreshButton" Content="重新检查"
                                HorizontalAlignment="Right" Click="Refresh_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ListenerDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{StaticResource StatusIdleBrush}" />
                        <TextBlock x:Name="ListenerText" Text="通知监听：正在检查" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="FocusDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{StaticResource StatusIdleBrush}" />
                        <TextBlock x:Name="FocusText" Text="系统专注模式：正在检查" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ClassifierDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{StaticResource StatusIdleBrush}" />
                        <TextBlock x:Name="ClassifierText" Text="分类模型：正在检查" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ModelDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{StaticResource StatusIdleBrush}" />
                        <TextBlock x:Name="ModelText" Text="摘要模型：正在检查" />
                    </StackPanel>

                    <TextBlock x:Name="StatusHint" Style="{StaticResource DonySecondaryStyle}"
                               Text="通知服务随 intelligentSTUDIO 主程序启动；主程序未运行时，状态无法读取。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DonyCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="摘要参数" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="ThresholdBox" Grid.Column="0"
                                   Header="开始生成摘要的条数"
                                   Minimum="2" Maximum="99" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" />
                        <Button x:Name="SaveThresholdButton" Grid.Column="1" Content="保存"
                                VerticalAlignment="Bottom" Click="SaveThreshold_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource DonySecondaryStyle}"
                               Text="同一应用的通知在 60 秒内达到此条数后生成首条摘要；此后每有新通知，间隔 30 秒再更新。" />
                    <InfoBar x:Name="ThresholdBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ModelBar" IsOpen="False" IsClosable="False" Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</Page>
